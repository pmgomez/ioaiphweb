{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ioaiphweb",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "alias": {
    "#tanstack-router-entry": "./.tanstack/router/entry.js",
    "#tanstack-start-plugin-adapters": "@tanstack/start-server-core/dist/esm/plugin-adapters.js",
    "tanstack-start-manifest:v": "@tanstack/start-server-core/dist/esm/router-manifest.js",
    "tanstack-start-injected-head-scripts:v": "@tanstack/start-server-core/dist/esm/injected-head-scripts.js"
  }
}
